* text=auto
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
# Audit CSV hashes are byte-sensitive; preserve their original line endings.
*.csv -text whitespace=cr-at-eol
*.svg text eol=lf -whitespace
*.png binary
*.pdf binary
